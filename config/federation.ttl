@prefix :       <https://civic-data.de/pipeline#> .
@prefix cdf:    <https://civic-data.de/federated-directory#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix ft:     <http://publications.europa.eu/resource/authority/file-type/> .

# ---- Federation ---------------------------------------------------------

:federation a :Federation ;
    rdfs:label       "Federated directory of social support services in Germany" ;
    :hasSource       :caritasSource, :sozialplattformSource, :awoSource ;
    :hasTargetSchema :traegerSchema, :beratungsstelleSchema, :angebotSchema ;
    :hasMatchRule    :traegerMatch, :beratungsstelleMatch, :angebotMatch ;
    :hasResolveRule  :resolve ;
    :hasRunParam     [ :name "plz" ; :value "10115", "10117", "10119", "10178", "10365",
                       "10435", "10551", "10557", "10559", "10785", "10963", "10969", "13347",
                       "13349", "13353", "13355", "13357", "13359", "13407" ] ;
    :hasExporter     "sozialplattform" ;
    :repository      "https://github.com/foederierter-datenpool/sosuse-directory-builder" .

# ---- Vocabulary ---------------------------------------------------------

cdf:CounselingCentre a rdfs:Class ;
    rdfs:subClassOf schema:Organization ;
    rdfs:label "Beratungsstelle"@de, "Counselling centre"@en .

# ---- Target schemas -----------------------------------------------------

:traegerSchema a :TargetSchema ;
    :targetClass schema:Organization ;
    rdfs:label "Träger"@de ;
    :hasTargetField :t-identifier, :t-name, :t-alternateName, :t-description,
                    :t-streetAddress, :t-postalCode, :t-locality, :t-country,
                    :t-telephone, :t-email, :t-homepage, :t-detailUrl,
                    :t-parentOrganization,
                    :t-harvestedAt, :t-sourceCreated, :t-sourceModified, :t-sourceReviewed .

:beratungsstelleSchema a :TargetSchema ;
    :targetClass cdf:CounselingCentre ;
    rdfs:label "Beratungsstelle"@de ;
    :hasTargetField :t-identifier, :t-name, :t-alternateName, :t-description,
                    :t-streetAddress, :t-postalCode, :t-locality, :t-country, :t-areaServed,
                    :t-telephone, :t-email, :t-homepage, :t-detailUrl,
                    :t-category, :t-availableService, :t-audience, :t-accessibilitySummary,
                    :t-openingHours, :t-parentOrganization, :t-parentOrgClassification,
                    :t-harvestedAt, :t-sourceCreated, :t-sourceModified, :t-sourceReviewed .

:angebotSchema a :TargetSchema ;
    :targetClass schema:Service ;
    rdfs:label "Angebot"@de ;
    :hasTargetField :t-identifier, :t-name, :t-category, :t-codeValue, :t-areaServed, :t-provider .

# :multiValued - one value per contributing source is expected; the Merge view doesn't flag these as conflicts
:t-identifier           a :TargetField ; :targetPredicate schema:identifier ; :multiValued true .
:t-name                 a :TargetField ; :targetPredicate schema:name .
:t-alternateName        a :TargetField ; :targetPredicate schema:alternateName .
:t-description          a :TargetField ; :targetPredicate schema:description .

:t-streetAddress        a :TargetField ; :targetPredicate schema:streetAddress .
:t-postalCode           a :TargetField ; :targetPredicate schema:postalCode .
:t-locality             a :TargetField ; :targetPredicate schema:addressLocality .
:t-country              a :TargetField ; :targetPredicate schema:addressCountry .
:t-areaServed           a :TargetField ; :targetPredicate schema:areaServed .

:t-telephone            a :TargetField ; :targetPredicate schema:telephone .
:t-email                a :TargetField ; :targetPredicate schema:email .
:t-homepage             a :TargetField ; :targetPredicate foaf:homepage .
:t-detailUrl            a :TargetField ; :targetPredicate schema:mainEntityOfPage .

:t-category             a :TargetField ; :targetPredicate schema:category .
:t-availableService     a :TargetField ; :targetPredicate schema:availableService .
:t-audience             a :TargetField ; :targetPredicate schema:audience .
:t-accessibilitySummary a :TargetField ; :targetPredicate schema:accessibilitySummary .
:t-openingHours         a :TargetField ; :targetPredicate schema:openingHours .
:t-parentOrganization   a :TargetField ; :targetPredicate schema:parentOrganization .
:t-provider             a :TargetField ; :targetPredicate schema:provider .
:t-codeValue            a :TargetField ; :targetPredicate schema:codeValue .
:t-parentOrgClassification a :TargetField ; :targetPredicate cdf:parentOrgClassification .

# Temporal fields, all unmapped for now
:t-harvestedAt          a :TargetField ; :targetPredicate prov:generatedAtTime .
:t-sourceCreated        a :TargetField ; :targetPredicate dct:created .
:t-sourceModified       a :TargetField ; :targetPredicate dct:modified .
:t-sourceReviewed       a :TargetField ; :targetPredicate schema:lastReviewed .

# ---- Sources ------------------------------------------------------------

:caritasSource a :Source ;
    rdfs:label    "Caritas" ;
    skos:notation "ca" ;
    :fetchUrl     "https://www.caritas.de/Api/search/searchbyquery" ;
    :retrieval    "API" ;
    :format       ft:JSON ;
    :hasField   :caritas-Categories, :caritas-ContentType, :caritas-ContentTypeGuid, :caritas-Date, :caritas-Distance,
                :caritas-Format, :caritas-Guid, :caritas-Index, :caritas-LeadLine, :caritas-Link,
                :caritas-OnlineConsultingUrl, :caritas-SearchResultHtml, :caritas-SubTitle, :caritas-Teaser,
                :caritas-Title, :caritas-ViewType .

:caritas-Categories          a :SourceField ; :fieldPath "Categories"          .
:caritas-ContentType         a :SourceField ; :fieldPath "ContentType"         .
:caritas-ContentTypeGuid     a :SourceField ; :fieldPath "ContentTypeGuid"     .
:caritas-Date                a :SourceField ; :fieldPath "Date"                .
:caritas-Distance            a :SourceField ; :fieldPath "Distance"            .
:caritas-Format              a :SourceField ; :fieldPath "Format"              .
:caritas-Guid                a :SourceField ; :fieldPath "Guid"                .
:caritas-Index               a :SourceField ; :fieldPath "Index"               .
:caritas-LeadLine            a :SourceField ; :fieldPath "LeadLine"            .
:caritas-Link                a :SourceField ; :fieldPath "Link"                .
:caritas-OnlineConsultingUrl a :SourceField ; :fieldPath "OnlineConsultingUrl" .
:caritas-SearchResultHtml    a :SourceField ; :fieldPath "SearchResultHtml"    .
:caritas-SubTitle            a :SourceField ; :fieldPath "SubTitle"            .
:caritas-Teaser              a :SourceField ; :fieldPath "Teaser"              .
:caritas-Title               a :SourceField ; :fieldPath "Title"               .
:caritas-ViewType            a :SourceField ; :fieldPath "ViewType"            .

# -------------------------------------------------------------------------

:sozialplattformSource a :Source ;
    rdfs:label    "Sozialplattform" ;
    skos:notation "sp" ;
    :fetchUrl     "https://sozialplattform.de/content/de/api/v1/consultation/search" ;
    :retrieval    "API" ;
    :format       ft:JSON ;
    :hasField   :sp-offer_chat_topic, :sp-offer_external_id_booking, :sp-offer_external_service_booking,
                :sp-offer_external_service_consulting, :sp-offer_external_service_link_text,
                :sp-offer_external_service_link_url, :sp-offer_external_service_type, :sp-offer_id, :sp-offer_nid,
                :sp-offer_service_area, :sp-offer_title, :sp-offer_type, :sp-office_address, :sp-office_address_short,
                :sp-office_email, :sp-office_external_id_booking, :sp-office_external_id_consulting,
                :sp-office_external_service_booking, :sp-office_external_service_consulting,
                :sp-office_external_service_type, :sp-office_opening_hours, :sp-office_opening_hours_notes,
                :sp-office_phone, :sp-office_title, :sp-search_score .

:sp-offer_chat_topic                   a :SourceField ; :fieldPath "offer_chat_topic"                   .
:sp-offer_external_id_booking          a :SourceField ; :fieldPath "offer_external_id_booking"          .
:sp-offer_external_service_booking     a :SourceField ; :fieldPath "offer_external_service_booking"     .
:sp-offer_external_service_consulting  a :SourceField ; :fieldPath "offer_external_service_consulting"  .
:sp-offer_external_service_link_text   a :SourceField ; :fieldPath "offer_external_service_link_text"   .
:sp-offer_external_service_link_url    a :SourceField ; :fieldPath "offer_external_service_link_url"    .
:sp-offer_external_service_type        a :SourceField ; :fieldPath "offer_external_service_type"        .
:sp-offer_id                           a :SourceField ; :fieldPath "offer_id"                           .
:sp-offer_nid                          a :SourceField ; :fieldPath "offer_nid"                          .
:sp-offer_service_area                 a :SourceField ; :fieldPath "offer_service_area"                 .
:sp-offer_title                        a :SourceField ; :fieldPath "offer_title"                        .
:sp-offer_type                         a :SourceField ; :fieldPath "offer_type"                         .
:sp-office_address                     a :SourceField ; :fieldPath "office_address" ;
    :hasSubField :sp-office_address-address_line1, :sp-office_address-address_line3, :sp-office_address-country_code,
                 :sp-office_address-langcode, :sp-office_address-locality, :sp-office_address-postal_code .

:sp-office_address-address_line1 a :SubField ; :fieldPath "address_line1" .
:sp-office_address-address_line3 a :SubField ; :fieldPath "address_line3" .
:sp-office_address-country_code  a :SubField ; :fieldPath "country_code"  .
:sp-office_address-langcode      a :SubField ; :fieldPath "langcode"      .
:sp-office_address-locality      a :SubField ; :fieldPath "locality"      .
:sp-office_address-postal_code   a :SubField ; :fieldPath "postal_code"   .

:sp-office_address_short               a :SourceField ; :fieldPath "office_address_short"               .
:sp-office_email                       a :SourceField ; :fieldPath "office_email"                       .
:sp-office_external_id_booking         a :SourceField ; :fieldPath "office_external_id_booking"         .
:sp-office_external_id_consulting      a :SourceField ; :fieldPath "office_external_id_consulting"      .
:sp-office_external_service_booking    a :SourceField ; :fieldPath "office_external_service_booking"    .
:sp-office_external_service_consulting a :SourceField ; :fieldPath "office_external_service_consulting" .
:sp-office_external_service_type       a :SourceField ; :fieldPath "office_external_service_type"       .
:sp-office_opening_hours               a :SourceField ; :fieldPath "office_opening_hours"               .
:sp-office_opening_hours_notes         a :SourceField ; :fieldPath "office_opening_hours_notes"         .
:sp-office_phone                       a :SourceField ; :fieldPath "office_phone"                       .
:sp-office_title                       a :SourceField ; :fieldPath "office_title"                       .
:sp-search_score                       a :SourceField ; :fieldPath "search_score"                       .

# -------------------------------------------------------------------------

:awoSource a :Source ;
    rdfs:label    "Arbeiterwohlfahrt (AWO)" ;
    skos:notation "awo" ;
    :dedupWithinSource false ;
    :retrieval    "Files" ;
    :format       ft:JSON ;
    :hasField   :awo-id, :awo-name, :awo-name_zusatz, :awo-webseite, :awo-parent_name,
                :awo-adresse, :awo-plz, :awo-ort, :awo-ortsteil, :awo-category,
                :awo-svc-id, :awo-svc-bagfw, :awo-svc-area .

:awo-id          a :SourceField ; :fieldPath "id"          .
:awo-name        a :SourceField ; :fieldPath "name"        .
:awo-name_zusatz a :SourceField ; :fieldPath "name_zusatz" .
:awo-webseite    a :SourceField ; :fieldPath "webseite"    .
:awo-parent_name a :SourceField ; :fieldPath "parent_name" .
:awo-adresse     a :SourceField ; :fieldPath "adresse"     .
:awo-plz         a :SourceField ; :fieldPath "plz"         .
:awo-ort         a :SourceField ; :fieldPath "ort"         .
:awo-ortsteil    a :SourceField ; :fieldPath "ortsteil"    .
:awo-category    a :SourceField ; :fieldPath "category"    .

# Service-side source fields — one schema:Service per services[] element.
:awo-svc-id    a :SourceField ; :fieldPath "id"          .
:awo-svc-area  a :SourceField ; :fieldPath "area_served" .
:awo-svc-bagfw a :SourceField ; :fieldPath "bagfw_category" ;
    :hasSubField :awo-svc-bagfw-nummer, :awo-svc-bagfw-name .
:awo-svc-bagfw-nummer a :SubField ; :fieldPath "nummer" .
:awo-svc-bagfw-name   a :SubField ; :fieldPath "name" .

# ---- Mappings -----------------------------------------------------------

:caritas-beratungsstelle-mapping a :Mapping ;
    :fromSource    :caritasSource ;
    :toTarget      :beratungsstelleSchema ;
    :hasFieldMapping
        [ :from :caritas-Guid     ; :to :t-identifier    ] ,
        [ :from :caritas-Title    ; :to :t-name          ] ,
        [ :from :caritas-SubTitle ; :to :t-alternateName ] ,
        [ :from :caritas-LeadLine ; :to :t-category      ] ,
        [ :from :caritas-Link     ; :to :t-detailUrl     ] ,
        [ :from :caritas-Teaser   ; :to :t-streetAddress, :t-postalCode, :t-locality ;
                                    :via "address" ] .

# Sozialplattform is offer-first: the clean step splits each row into an office
# org + an offer service (see sozialplattform.sparql), so it has two mappings.
:sp-beratungsstelle-mapping a :Mapping ;
    :fromSource    :sozialplattformSource ;
    :toTarget      :beratungsstelleSchema ;
    :hasFieldMapping
        [ :from :sp-office_title                 ; :to :t-name          ] ,
        [ :from :sp-office_opening_hours         ; :to :t-openingHours  ] ,
        [ :from :sp-office_opening_hours_notes   ; :to :t-openingHours  ] ,
        [ :from :sp-office_address-address_line1 ; :to :t-streetAddress ] ,
        [ :from :sp-office_address-postal_code   ; :to :t-postalCode    ] ,
        [ :from :sp-office_address-locality      ; :to :t-locality      ] ,
        [ :from :sp-office_address-country_code  ; :to :t-country       ] ,
        [ :from :sp-office_phone                 ; :to :t-telephone     ] ,
        [ :from :sp-office_email                 ; :to :t-email         ] .

:sp-angebot-mapping a :Mapping ;
    :fromSource    :sozialplattformSource ;
    :toTarget      :angebotSchema ;
    :hasFieldMapping
        [ :from :sp-offer_id                        ; :to :t-identifier ] ,
        [ :from :sp-offer_title                     ; :to :t-name       ] ,
        [ :from :sp-offer_type                      ; :to :t-category   ] ,
        [ :from :sp-offer_chat_topic                ; :to :t-audience   ] ,
        [ :from :sp-offer_service_area              ; :to :t-areaServed ] ,
        [ :from :sp-offer_external_service_link_url ; :to :t-detailUrl  ] ;
    :hasRelationship
        [ :sourcePredicate :providedBy ; :toTargetField :t-provider ; :toTargetSchema :beratungsstelleSchema ] .

:awo-traeger-mapping a :Mapping ;
    :fromSource    :awoSource ;
    :toTarget      :traegerSchema ;
    :hasFieldMapping
        [ :from :awo-id          ; :to :t-identifier         ] ,
        [ :from :awo-name        ; :to :t-name               ] ,
        [ :from :awo-name_zusatz ; :to :t-alternateName      ] ,
        [ :from :awo-webseite    ; :to :t-homepage           ] ,
        [ :from :awo-adresse     ; :to :t-streetAddress      ] ,
        [ :from :awo-plz         ; :to :t-postalCode         ] ,
        [ :from :awo-ort         ; :to :t-locality           ] .

:awo-beratungsstelle-mapping a :Mapping ;
    :fromSource    :awoSource ;
    :toTarget      :beratungsstelleSchema ;
    :hasFieldMapping
        [ :from :awo-id          ; :to :t-identifier         ] ,
        [ :from :awo-name        ; :to :t-name               ] ,
        [ :from :awo-name_zusatz ; :to :t-alternateName      ] ,
        [ :from :awo-webseite    ; :to :t-homepage           ] ,
        [ :from :awo-adresse     ; :to :t-streetAddress      ] ,
        [ :from :awo-plz         ; :to :t-postalCode         ] ,
        [ :from :awo-ort         ; :to :t-locality           ] ,
        [ :from :awo-category    ; :to :t-category           ] ;
    :hasRelationship
        [ :sourcePredicate :hasParent ; :toTargetField :t-parentOrganization ; :toTargetSchema :traegerSchema ] .

:awo-angebot-mapping a :Mapping ;
    :fromSource    :awoSource ;
    :toTarget      :angebotSchema ;
    :hasFieldMapping
        [ :from :awo-svc-id           ; :to :t-identifier ] ,
        [ :from :awo-svc-bagfw-name   ; :to :t-category   ] ,
        [ :from :awo-svc-bagfw-nummer ; :to :t-codeValue  ] ,
        [ :from :awo-svc-area         ; :to :t-areaServed ] ;
    :hasRelationship
        [ :sourcePredicate :providedBy ; :toTargetField :t-provider ; :toTargetSchema :beratungsstelleSchema ] ,
        [ :sourcePredicate :providedBy ; :toTargetField :t-provider ; :toTargetSchema :traegerSchema ] .

# ---- Match --------------------------------------------------------------

:beratungsstelleMatch a :MatchRule ;
    :forTarget           :beratungsstelleSchema ;
    :targetNamespace     "https://civic-data.de/federated-directory#" ;
    :mintedSubjectPrefix "org-" ;
    :hasHardCriterion     [ :on schema:postalCode ] ;
    :minScore             0.55 ;
    :hasWeightedCriterion
        [ :on schema:name          ; :weight 0.5 ] ,
        [ :on schema:streetAddress ; :weight 0.2 ; :minSimilarity 0.7 ] .

:traegerMatch a :MatchRule ;
    :forTarget           :traegerSchema ;
    :targetNamespace     "https://civic-data.de/federated-directory#" ;
    :mintedSubjectPrefix "traeger-" .

:angebotMatch a :MatchRule ;
    :forTarget           :angebotSchema ;
    :targetNamespace     "https://civic-data.de/federated-directory#" ;
    :mintedSubjectPrefix "service-" ;
    :hasHardCriterion     [ :on schema:provider ] ;
    :minScore             0.85 ;
    :hasWeightedCriterion [ :on schema:name ; :weight 1.0 ] .

# ---- Resolve ------------------------------------------------------------

:resolve a :ResolveRule ;
    :defaultStrategy :alphabeticFirst ;
    :hasOverride     [ :on schema:availableService ; :strategy :concatenateAll ] .
