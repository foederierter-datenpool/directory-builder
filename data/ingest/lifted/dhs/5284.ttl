                                                          "<div class=\"container\">\n <button class=\"btn navbar-toggler collapsed\" type=\"button\" data-toggle=\"collapse\" data-target=\"#mainnavigation\" aria-expanded=\"false\" aria-label=\"Navigation umschalten\"><span class=\"navbar-toggler-icon\"></span></button>\n <nav id=\"mainnavigation\" class=\"collapse navbar-collapse\" aria-label=\"Hauptnavigation\">\n  <ul class=\"navbar-nav\" id=\"sr_mainnavigation\">\n   <li class=\"nav-item nav-item dropdown dropdown-hover\"><a class=\"nav-link\" title=\"Zur Startseite\" href=\"/\"><img alt=\"Zur Startseite\" src=\"https://www.dhs.de/typo3conf/ext/dhs_sitepackage/Resources/Public/Images/Icons/home.svg\" width=\"50\" height=\"35\"></a></li>\n   <li class=\"nav-item dropdown dropdown-hover\"><a href=\"/die-dhs/\" id=\"nav-item-2\" class=\"nav-link dropdown-toggle\" aria-haspopup=\"true\" aria-expanded=\"false\"><span class=\"nav-link-text\">Die DHS</span></a>\n    <ul class=\"dropdown-menu ebene1\" aria-labelledby=\"nav-item-2\">\n     <li class=\"\"><a href=\"/die-dhs/vorstand/\" id=\"nav-item-8\" class=\" dropdown-item\"><span class=\"dropdown-text\">Vorstand</span></a></li>\n     <li class=\"\"><a href=\"/die-dhs/ausschuesse/\" id=\"nav-item-11\" class=\" dropdown-item\"><span class=\"dropdown-text\">Ausschüsse</span></a></li>\n     <li class=\"\"><a href=\"/die-dhs/wissenschaftliches-kuratorium/\" id=\"nav-item-9\" class=\" dropdown-item\"><span class=\"dropdown-text\">Wissenschaftliches Kuratorium</span></a></li>\n     <li class=\"\"><a href=\"/die-dhs/mitglieder/\" id=\"nav-item-7\" class=\" dropdown-item\"><span class=\"dropdown-text\">Mitglieder</span></a></li>\n     <li class=\"\"><a href=\"/die-dhs/kooperationspartner/\" id=\"nav-item-10\" class=\" dropdown-item\"><span class=\"dropdown-text\">Kooperierende Organisationen</span></a></li>\n     <li class=\"\"><a href=\"/die-dhs/landesstellen/\" id=\"nav-item-12\" class=\" dropdown-item\"><span class=\"dropdow