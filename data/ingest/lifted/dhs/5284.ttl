                                  "<nav aria-label=\"Sprunglinks\">\n <ol id=\"sr_jumptable\" class=\"skip\">\n  <li><a class=\"visually-hidden-focusable\" href=\"#metanavigation\"><span>Sprung zur Servicenavigation</span></a></li>\n  <li><a class=\"visually-hidden-focusable\" href=\"#sr_mainnavigation\"><span>Sprung zur Hauptnavigation</span></a></li>\n  <li><a class=\"visually-hidden-focusable\" href=\"#search\"><span>Sprung zur Suche</span></a></li>\n  <li><a class=\"visually-hidden-focusable\" href=\"#sr_subnavigation\"><span>Sprung zur Unternavigation</span></a></li>\n  <li><a class=\"visually-hidden-focusable\" href=\"#page-content\"><span>Sprung zum Inhalt</span></a></li>\n  <li><a class=\"visually-hidden-focusable\" href=\"#page-footer\"><span>Sprung zum Fußbereich</span></a></li>\n </ol>\n</nav>\n<div id=\"scrollheader\" class=\"navbar-fixed-top\">\n <header id=\"page-header-pre\">\n  <div class=\"container\">\n   <a class=\"navbar-brand col-4 navbar-brand-image\" title=\"Link zur Startseite\" href=\"/\"><img class=\"navbar-brand-logo-normal\" alt=\"main logo\" src=\"https://www.dhs.de/typo3conf/ext/dhs_sitepackage/Resources/Public/Images/Logo/dhs.svg\" width=\"300\" height=\"200\"></a>\n   <nav id=\"metanavigation\" class=\"col-8 d-sm-block\" aria-label=\"Servicenavigation\">\n    <ul id=\"metanavigation_navigate\" class=\"d-flex justify-content-end\">\n     <li><a class=\"gbsprache\" href=\"/gebaerdensprache/\">Gebärdensprache</a></li>\n     <li><a class=\"ltsprache\" href=\"/leichte-sprache/\">Leichte Sprache</a></li>\n     <li><a class=\"barrierefrei\" href=\"/barrierefreiheit/\">Barrierefreiheit</a></li>\n    </ul>\n    <div id=\"search\">\n     <form id=\"searchformsmall\" action=\"/service/suche/?tx_indexedsearch_pi2%5Baction%5D=search&amp;tx_indexedsearch_pi2%5Bcontroller%5D=Search&amp;cHash=56bbab29acdcd55f3c89ce12c17fb096\" method=\"post\">\n      <div>\n       <input type=\"hidden\" name=\"tx_indexedsearch_pi2[__referrer][@extension]\" value=\"\"